{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "declaration": false,
    "declarationMap": false,
    "lib": ["ES2022"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/server.ts", "src/types/**/*.ts", "src/agent/**/*.ts", "src/core/entity.ts"],
  "exclude": ["src/client"]
}
