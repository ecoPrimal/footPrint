{
  "name": "footprint",
  "version": "2.0.0",
  "description": "Home improvement planning tool with satellite map overlays and CAD-like drawing tools",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"tsx watch src/server.ts\" \"vite\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server.js",
    "start:dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "tsc --noEmit && eslint src/"
  },
  "keywords": [
    "home-improvement",
    "map",
    "planning",
    "cad",
    "leaflet",
    "typescript"
  ],
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.19.2",
    "@turf/area": "^7.3.5",
    "@turf/bearing": "^7.3.5",
    "@turf/boolean-intersects": "^7.3.5",
    "@turf/buffer": "^7.3.5",
    "@turf/centroid": "^7.3.5",
    "@turf/distance": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@turf/length": "^7.3.5",
    "@turf/line-intersect": "^7.3.5",
    "@turf/midpoint": "^7.3.5",
    "@turf/nearest-point-on-line": "^7.3.5",
    "@turf/polygon-to-line": "^7.3.5",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.2",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.17",
    "@types/node": "^22.13.14",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.1.2",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
