# footPrint Express server — systemd unit
# Install: cp deploy/footprint.service /etc/systemd/system/
#          systemctl daemon-reload && systemctl enable --now footprint
#
# Deploy on ironGate downstream host (10.13.37.7).
# Expects: npm ci && npm run build completed in WorkingDirectory

[Unit]
Description=footPrint Express server (project persistence + agent bridge)
After=network.target
Documentation=https://git.primals.eco/protoKarya/footPrint

[Service]
Type=simple
User=membrane
Group=membrane
WorkingDirectory=/opt/ecoPrimals/protists/footPrint
Environment=PORT=3002
Environment=NODE_ENV=production
# CAS routing: TCP JSON-RPC to nestGate (same-gate local-trust, no BTSP needed)
Environment=NESTGATE_RPC_PORT=8080
# Alternative: explicit URL format
# Environment=NESTGATE_RPC_URL=tcp://127.0.0.1:8080
# UDS (requires BTSP when FAMILY_ID set — for future biomeOS capability routing):
# Environment=MEMBRANE_SOCKET=/run/membrane/nestgate.sock
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

ReadWritePaths=/opt/ecoPrimals/protists/footPrint/projects
ReadWritePaths=/opt/ecoPrimals/protists/footPrint/cache
ReadOnlyPaths=/run/membrane

ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
