# footPrint reverse proxy — Caddy snippet for golgi
# With subdomain routing (footprint.primals.eco), Caddy reverse-proxies
# everything to the Express server. SPA fallback is handled server-side.
#
# Assumes footPrint Express runs on sporeGate at 10.13.37.2:3000.

footprint.primals.eco {
	reverse_proxy 10.13.37.2:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
